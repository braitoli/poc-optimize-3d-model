#!/usr/bin/env bash
# ==============================================================================
# bin/optimize-3d
#
# Unified CLI entrypoint for 3D model (.glb) optimization pipeline.
# Usage: ./bin/optimize-3d <input.glb> <output.glb> [options]
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Activate virtualenv if present
if [[ -f "${REPO_ROOT}/.venv/bin/python" ]]; then
    PYTHON_BIN="${REPO_ROOT}/.venv/bin/python"
elif [[ -f "${REPO_ROOT}/venv/bin/python" ]]; then
    PYTHON_BIN="${REPO_ROOT}/venv/bin/python"
elif command -v python3 &>/dev/null; then
    PYTHON_BIN="python3"
else
    echo "Error: Python 3 is required but not found in PATH or virtualenv." >&2
    exit 1
fi

# Verify node
if ! command -v node &>/dev/null; then
    echo "Error: Node.js (>=18) is required but not found in PATH." >&2
    exit 1
fi

# Run python CLI
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
exec "${PYTHON_BIN}" -m optimizer.cli "$@"
