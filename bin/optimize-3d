#!/usr/bin/env bash
# ==============================================================================
# bin/optimize-3d
#
# Unified CLI entrypoint for 3D model (.glb) optimization pipeline.
# Runs optimizer.step_pipeline into a temp dir and copies its final step
# (step_07_final.glb) to <output.glb>.
# Usage: ./bin/optimize-3d <input.glb> <output.glb> [options]
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Activate virtualenv if present
if [[ -f "${REPO_ROOT}/.venv/bin/python" ]]; then
    PYTHON_BIN="${REPO_ROOT}/.venv/bin/python"
elif [[ -f "${REPO_ROOT}/venv/bin/python" ]]; then
    PYTHON_BIN="${REPO_ROOT}/venv/bin/python"
elif command -v python3 &>/dev/null; then
    PYTHON_BIN="python3"
else
    echo "Error: Python 3 is required but not found in PATH or virtualenv." >&2
    exit 1
fi

# Verify node
if ! command -v node &>/dev/null; then
    echo "Error: Node.js (>=18) is required but not found in PATH." >&2
    exit 1
fi

usage() {
    cat <<'EOF'
Usage: optimize-3d <input.glb> <output.glb> [options]

.glb optimizer (runs optimizer.step_pipeline).

Options:
  -f, --format FMT      Texture format: ktx2, webp, original (default: ktx2)
      --uv-mode MODE    UV unwrap mode: xatlas, uvatlas (default: xatlas)
      --downscale on|off
                        on: re-chart UVs on a canvas sized at 1:1 texel density
                        (original kept when that canvas is not smaller);
                        off: keep original UVs, texture and resolution (default: on)
      --size-mode MODE  Canvas size when downscale is on: exact (smallest square,
                        multiple of 4), pot-up (power of two, 1:1 or better),
                        pot-down (power of two, islands scaled down) (default: exact)
      --merge-uv-islands on|off
                        Merge UV islands that can be merged, to spend less of the
                        canvas on gutter padding (default: on)
      --skip-steps LIST Comma-separated steps to skip, e.g. 3,5 (steps 1-6 are
                        optional; step 0 and the final step always run)
      --reduce-engine E Step 3 face reduction engine: cgal, meshlab (default: cgal)
      --reduce-ops LIST Step 3 operations: repair, self_intersection, isolated,
                        hidden, merge (default: repair,isolated,hidden,merge)
      --reduce-quality-budget PCT
                        How far step 3 may move the visible surface, in percent of
                        the bounding box diagonal (default: 0.1)
      --reduce-normal-budget DEG
                        How far step 3 may let the surface turn away from the
                        original, in degrees at the 99th percentile - keeps sharp
                        edges and narrow slots, which a position-only budget
                        cannot see (default: 20)
      --reduce-isolated-min-faces N
                        Step 3 drops components with fewer faces than this (default: 25)
      --double-sided    Keep double-sided materials (default: single-sided FrontSide)
  -q, --quiet           Suppress progress logs
  -h, --help            Show this help and exit
EOF
}

INPUT=""
OUTPUT=""
QUIET=0
PIPELINE_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -f|--format|--uv-mode|--downscale|--size-mode|--merge-uv-islands|--skip-steps|\
        --reduce-engine|--reduce-ops|--reduce-quality-budget|--reduce-normal-budget|\
        --reduce-isolated-min-faces)
            if [[ $# -lt 2 ]]; then
                echo "Error: $1 requires a value." >&2
                exit 2
            fi
            PIPELINE_ARGS+=("$1" "$2")
            shift 2
            ;;
        --double-sided)
            PIPELINE_ARGS+=("$1")
            shift
            ;;
        -q|--quiet)
            PIPELINE_ARGS+=("$1")
            QUIET=1
            shift
            ;;
        -*)
            echo "Error: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
        *)
            if [[ -z "${INPUT}" ]]; then
                INPUT="$1"
            elif [[ -z "${OUTPUT}" ]]; then
                OUTPUT="$1"
            else
                echo "Error: unexpected argument: $1" >&2
                usage >&2
                exit 2
            fi
            shift
            ;;
    esac
done

if [[ -z "${INPUT}" || -z "${OUTPUT}" ]]; then
    echo "Error: <input.glb> and <output.glb> are required." >&2
    usage >&2
    exit 2
fi

TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/optimize-3d.XXXXXX")"
trap 'rm -rf "${TMP_DIR}"' EXIT

# Run step pipeline (stdout carries NDJSON step events for the web server; not needed here)
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH:-}"
"${PYTHON_BIN}" -m optimizer.step_pipeline "${INPUT}" --output-dir "${TMP_DIR}" \
    ${PIPELINE_ARGS[@]+"${PIPELINE_ARGS[@]}"} > /dev/null

mkdir -p "$(dirname "${OUTPUT}")"
cp "${TMP_DIR}/step_07_final.glb" "${OUTPUT}"

if [[ "${QUIET}" -eq 0 ]]; then
    echo "Output written to: ${OUTPUT}" >&2
fi
